# Nightly market-data ingest from AutoScout24. Builds the price baseline every
# score is measured against. Sends a Telegram report when it finishes.
# Triggered by swisscarscout-index.timer, not enabled directly.
[Unit]
Description=SwissCarScout market index
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/SwissCarScout
EnvironmentFile=/home/ubuntu/SwissCarScout/.env
ExecStart=/home/ubuntu/SwissCarScout/.venv/bin/python run.py --source autoscout24 --index
