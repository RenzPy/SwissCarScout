# Copy to .env, fill in, then:  chmod 600 .env
#
# Load it into a shell session with:
#   set -a; source .env; set +a
# systemd reads this file format directly (EnvironmentFile=).

# --- Telegram (required for alerts and for --listen) ---------------------
# Bot token from @BotFather
TG_TOKEN=
# Your chat id: message the bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TG_CHAT=

# --- Gemini (optional) ---------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# Without it the regex parser is used and nothing breaks.
GEMINI_API_KEY=
# "auto" picks the newest stable flash model the API offers and tells you on
# Telegram whenever that changes. Set a specific name only to pin one; if it
# is ever retired, the tool falls back to auto and tells you.
GEMINI_MODEL=auto
